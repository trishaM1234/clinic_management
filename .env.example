FLASK_DEBUG=false
AUTH_TOKEN=change-this-token
ORACLE_USER=system
ORACLE_PASSWORD=change-this-password
ORACLE_HOST=host.example.com
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=XE

# You can use ORACLE_DSN instead of ORACLE_HOST/ORACLE_PORT/ORACLE_SERVICE_NAME.
# ORACLE_DSN must be a full value like host.example.com:1521/XE.
# ORACLE_DSN=host.example.com:1521/XE
